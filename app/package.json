{
  "name": "levtrap-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "wheel": "node scripts/stage-wheel.mjs",
    "record": "python3 scripts/record-materials.py && python3 scripts/record-asphere.py && node scripts/record-references.mjs && node scripts/record-presets.ts",
    "test:e2e": "BASE_PATH=/levtrap/next next build && playwright test --trace off",
    "shots": "python3 scripts/review-shots.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "katex": "0.16.25",
    "lz-string": "1.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "^6.0.3"
  }
}
